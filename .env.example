# =============================================================================
# Local development — copy to `.env` and fill in values
# =============================================================================

# Supabase PostgreSQL (Transaction pooler — port 6543, for the running app)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase PostgreSQL (Direct connection — port 5432, for Prisma migrations)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Auth — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Plaid — https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# API server
PORT=5000
NODE_ENV=development

# Comma-separated origins allowed to call the API (set your Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# Plaid sync scheduler (runs on the API host, not Vercel)
SYNC_ENABLED=true
SYNC_CRON=0 * * * *

# =============================================================================
# Vercel only — set in Project Settings → Environment Variables (not in .env)
# =============================================================================
# VITE_API_BASE_URL=https://your-api.onrender.com

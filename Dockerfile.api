# API-only image (no frontend build). Use when Vercel hosts the React app.
FROM node:22

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma

RUN npm ci

COPY . .

RUN npm prune --production

EXPOSE 5000

ENV NODE_ENV=production
CMD ["sh", "-c", "npx prisma migrate deploy --schema=prisma/schema.prisma && node src/server/server.js"]
